# Copy this to .env (same directory) and fill in real values.
# .env is gitignored on purpose -- never commit your real secrets.

# --- Required for every deployment ---

# Shared key askers (sesame, a Custom GPT, your own scripts) use to call
# this bridge. Generate one with: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
AIBRIDGE_KEY=

# --- aibridge itself (optional, sensible defaults for local use) ---

# Public URL this bridge is reachable at. Only matters for the result_url
# your callers get back -- defaults to a plain localhost URL, which is
# fine if nothing outside this machine needs to reach it.
# AIBRIDGE_PUBLIC_BASE_URL=https://your-domain.example.com

# Host port to publish the bridge on (container always listens on 8097
# internally). Defaults to 8010.
# AIBRIDGE_HOST_PORT=8010

# Comma-separated alternate public ports to advertise in responses (see
# "Alternate ports" in README.md). Leave unset unless you actually have a
# second public port forwarded to this same service.
# AIBRIDGE_PUBLIC_PORTS=443,8443

# --- hermes-agent (only needed if you deploy the hermes provider) ---

# Shared secret between responder_hermes.py and Hermes Agent's own local
# API server (http://127.0.0.1:8642 inside that container). Generate the
# same way as AIBRIDGE_KEY above.
HERMES_API_KEY=

# Fallback LLM provider for Hermes Agent (used when its primary provider
# fails -- see "fallback_providers" in Hermes's own config.yaml, set up
# once via `hermes fallback add` inside the container). Optional.
GEMINI_API_KEY=

# Telegram bot integration for Hermes Agent (optional). Create a bot via
# @BotFather to get a token; TELEGRAM_ALLOWED_USERS is your own numeric
# Telegram user ID (comma-separated for more than one), found by messaging
# your bot once and calling its getUpdates endpoint.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Raises the Telegram file-transfer cap from 20MB to 2GB by self-hosting
# the official "Local Bot API Server" (see docker-compose.yml's
# telegram-bot-api service) -- needed for anything video-sized (the
# DaVinci Resolve pipeline, mainly). Optional: leave both blank and
# everything keeps working exactly as before, just capped at 20MB.
# These do NOT come from @BotFather -- log in with your own Telegram
# account at https://my.telegram.org -> "API development tools" -> create
# an app. It gives you a number (TELEGRAM_API_ID) and a hex string
# (TELEGRAM_API_HASH). This is a one-time, human-only step -- nothing
# automatable about it.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Speech-to-text for Telegram voice messages (optional, free tier
# available at console.groq.com). Without this, voice messages fail with
# "No STT provider available". Also used by SKILL_audio_transcription.md
# for transcribing uploaded audio files (not just native voice messages).
GROQ_API_KEY=

# Song/recording identification (Shazam-style, optional) -- see
# SKILL_audio_identify.md. Free API key, register at
# https://acoustid.org/api-key. Without this, that skill will say so
# instead of attempting a lookup.
ACOUSTID_API_KEY=

# Second fallback-model pool for Hermes Agent, on different infrastructure
# than the Nous free catalog (see fallback_providers in config.yaml) --
# added 2026-10-01 so a correlated outage on one vendor's free tier
# (observed happening to Nous) doesn't take down the whole fallback chain.
# Also unlocks Hermes's OpenRouter image_gen/video_gen plugins as a side
# effect. Free, register at https://openrouter.ai/sign-up (GitHub/Google
# OAuth is fastest), then create a key at https://openrouter.ai/keys.
# Free-tier rate limit is 50 req/day per key, or 1000 req/day once the
# account has ever held at least 10 USD of credit (no need to spend it).
OPENROUTER_API_KEY=
