{
  "_comment": "Copy to ~/.config/aibridge-workers/workers.json on the always-on host (private: it names the people's stacks), mode 600. WORKERS.md explains every key. host: the Docker host's aibridge user (ssh key, BatchMode). image: the stacks' image, loaded on this host from the build machine's tar. apply: how outputs enter a workdir on the Docker host ('docker' = a one-shot container of host_image as root, like project_sync; 'direct' = the host's python3 as aibridge). schedule: systemd OnCalendar (a zone at the end is the zone of the time).",
  "host": "aibridge@docker-host",
  "image": "aibridge-hermes-agent:latest",
  "host_image": "aibridge-hermes-agent:latest",
  "apply": "docker",
  "remote_inbox": "aibridge/worker-inbox",
  "state_dir": "~/.local/share/aibridge-workers",
  "sync_every_min": 2,
  "types": {
    "subs": {"schedule": "*-*-* 00/3:00:00", "memory": "1g", "cpus": 1, "timeout_s": 3600, "pids": 256},
    "jobnight": {"schedule": "*-*-* 04:30:00 America/Argentina/Buenos_Aires", "memory": "2g", "cpus": 2, "timeout_s": 3600, "pids": 512}
  },
  "people": {
    "stack-a": {
      "remote_workdir": "aibridge/stacks/stack-a/workdir",
      "jobs": {"subs": {"subs_dir": "descargas", "env": {"SUBS_BACKLOG_PER_RUN": "170"}}}
    },
    "stack-b": {
      "remote_workdir": "aibridge/stacks/stack-b/workdir",
      "jobs": {"jobnight": {"timezone": "America/Argentina/Buenos_Aires", "lang": "es"}}
    },
    "stack-c": {
      "_comment": "local_workdir (absolute, on THIS machine) instead of remote_workdir: this person's workdir already lives here (WORKERS.md 2b). No pull, push or ssh for them; 'host' may be left out when every person is local.",
      "local_workdir": "/srv/spaces/stack-c/workdir",
      "jobs": {"jobnight": {"timezone": "America/Argentina/Buenos_Aires"}}
    }
  }
}
