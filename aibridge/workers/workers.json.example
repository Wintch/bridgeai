{
  "_comment": "Copy to ~/.config/aibridge-workers/workers.json on the always-on host (private: it names the people's stacks), mode 600. WORKERS.md explains every key. host: the Docker host's aibridge user (ssh key, BatchMode). image: the stacks' image, loaded on this host from the build machine's tar. apply: how outputs enter a workdir on the Docker host ('docker' = a one-shot container of host_image as root, like project_sync; 'direct' = the host's python3 as aibridge). schedule: systemd OnCalendar (a zone at the end is the zone of the time).",
  "host": "aibridge@docker-host",
  "image": "aibridge-hermes-agent:latest",
  "host_image": "aibridge-hermes-agent:latest",
  "apply": "docker",
  "remote_inbox": "aibridge/worker-inbox",
  "state_dir": "~/.local/share/aibridge-workers",
  "sync_every_min": 2,
  "agenda_every_min": 5,
  "types": {
    "subs": {"schedule": "*-*-* 00/3:00:00", "memory": "1g", "cpus": 1, "timeout_s": 3600, "pids": 256},
    "jobnight": {"schedule": "*-*-* 04:30:00 America/Argentina/Buenos_Aires", "memory": "2g", "cpus": 2, "timeout_s": 3600, "pids": 512},
    "revista": {"schedule": "*-*-* 07:30:00 America/Argentina/Buenos_Aires", "memory": "256m", "cpus": 0.5, "timeout_s": 900, "pids": 64}
  },
  "people": {
    "stack-a": {
      "remote_workdir": "aibridge/stacks/stack-a/workdir",
      "jobs": {"subs": {"subs_dir": "descargas", "env": {"SUBS_BACKLOG_PER_RUN": "170"}}}
    },
    "stack-b": {
      "remote_workdir": "aibridge/stacks/stack-b/workdir",
      "jobs": {"jobnight": {"timezone": "America/Argentina/Buenos_Aires", "lang": "es"}}
    },
    "stack-c": {
      "_comment": "local_workdir (absolute, on THIS machine) instead of remote_workdir: this person's workdir already lives here (WORKERS.md 2b). No pull, push or ssh for them; 'host' may be left out when every person is local. Their agenda (/workdir/.agenda.json) is run here by agenda-tick (WORKERS.md 11); bot_api: the Bot API server of this stack's bot, for the agenda's reminders (local_persist: optional, default <local_workdir>/../persist).",
      "local_workdir": "/srv/spaces/stack-c/workdir",
      "bot_api": "http://bot-api-host:8081",
      "jobs": {"jobnight": {"timezone": "America/Argentina/Buenos_Aires"}}
    },
    "novedades": {
      "_comment": "The morning magazine (WORKERS.md 'The revista type'), local data only. local_hub: this person's folder of the hub's data on THIS machine (<hubdata>/people/<stack>, what the stack sees at /hub). local_persist: default <local_workdir>/../persist (cron/jobs.json, .env, auth.json, read-only). bot_api: the always-on Bot API server that serves this stack's bot (base URL only, no token). local_gateways, local_stack_env, cloud_order, job, model_timeout_s: optional.",
      "local_workdir": "/srv/spaces/novedades/workdir",
      "jobs": {"revista": {"local_hub": "/srv/hubdata/people/novedades", "bot_api": "http://bot-api-host:8081",
                           "timezone": "America/Argentina/Buenos_Aires"}}
    }
  }
}
