{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "statefeed item, schema version 1 (type kev)",
  "description": "One line of items.ndjson. Patterns use Unicode property escapes (ECMA 262, u flag). Rules that JSON Schema cannot express and that the reference validator (statefeed/common.py) also enforces: dates must exist on the calendar; the line must be the canonical JSON of the object (sorted keys, no spaces, UTF-8, one trailing newline); lines are sorted by id with no duplicates; agreement.independent <= agreement.channels, single_channel means channels == 1, authoritative and disputed mean channels >= 2; source ids are unique within an item. Free text is deliberately absent: labels are short, restricted-alphabet strings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schema_version", "type", "vendor", "product", "name", "date_added", "due_date", "ransomware", "cwes",
               "epss", "epss_percentile", "epss_date", "agreement", "sources", "first_seen"],
  "$defs": {
    "label120": {"type": "string", "pattern": "^[\\p{L}\\p{N}_ .,:;()/+&'#@-]{1,120}$", "not": {"pattern": "://"}},
    "label200": {"type": "string", "pattern": "^[\\p{L}\\p{N}_ .,:;()/+&'#@-]{1,200}$", "not": {"pattern": "://"}},
    "label60": {"type": "string", "pattern": "^[\\p{L}\\p{N}_ .,:;()/+&'#@-]{1,60}$", "not": {"pattern": "://"}},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "unit": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "properties": {
    "id": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,7}$"},
    "schema_version": {"const": 1},
    "type": {"const": "kev"},
    "vendor": {"$ref": "#/$defs/label120"},
    "product": {"$ref": "#/$defs/label120"},
    "name": {"$ref": "#/$defs/label200"},
    "date_added": {"$ref": "#/$defs/date"},
    "due_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
    "ransomware": {"enum": ["known", "unknown"]},
    "cwes": {"type": "array", "maxItems": 10, "items": {"type": "string", "pattern": "^CWE-[0-9]{1,5}$"}},
    "epss": {"anyOf": [{"$ref": "#/$defs/unit"}, {"type": "null"}]},
    "epss_percentile": {"anyOf": [{"$ref": "#/$defs/unit"}, {"type": "null"}]},
    "epss_date": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "channels", "independent"],
      "properties": {
        "state": {"enum": ["authoritative", "single_channel", "disputed"]},
        "channels": {"type": "integer", "minimum": 1, "maximum": 10},
        "independent": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "licence", "content_sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"},
          "licence": {"$ref": "#/$defs/label60"},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "first_seen": {"$ref": "#/$defs/date"}
  }
}
