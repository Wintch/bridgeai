{
  "reserve_mb": 1500,
  "critical_mb": 700,
  "max_awake": 4,
  "warm_hours": 24,
  "warm_max": 3,
  "cache_floor_mb": 2000,
  "notice_after_hours": 6,
  "day_hours": "09-21",
  "refresh_hour": 5,
  "refresh_rss_mb": 1500,
  "cron": {
    "min_interval_min": 60,
    "grid_minutes": 60,
    "slot_seconds": 240,
    "stack_offset_seconds": 600,
    "hold_seconds": 180,
    "retry_seconds": 600,
    "ignore_names": [
      "jobwatch"
    ]
  },
  "night": {
    "after": "23:00",
    "idle_minutes": 60,
    "jobs": [
      "jobnight"
    ]
  },
  "stacks": [
    {
      "name": "demo-a",
      "bind": "172.21.0.1",
      "port": 3099,
      "front": "aibridge-web",
      "web": [
        "aibridge-open-webui",
        "aibridge-voice-proxy"
      ],
      "brain": "aibridge-hermes-agent",
      "idle_web": 600,
      "idle_brain": 600,
      "est_brain_mb": 700,
      "est_web_mb": 300,
      "telegram_env": "<home>/aibridge/.env",
      "telegram_api": "aibridge-telegram-bot-api",
      "warm": true,
      "workdir": "<home>/aibridge/user1-workdir",
      "tz_offset_min": -180
    },
    {
      "name": "demo-b",
      "bind": "172.28.1.1",
      "port": 3099,
      "front": "stack-demo-b-web",
      "web": [
        "stack-demo-b-open-webui",
        "stack-demo-b-voice"
      ],
      "brain": "stack-demo-b-hermes",
      "idle_web": 600,
      "idle_brain": 600,
      "est_brain_mb": 600,
      "est_web_mb": 300,
      "warm": true
    },
    {
      "name": "demo-c",
      "bind": "172.28.2.1",
      "port": 3099,
      "front": "stack-demo-c-web",
      "web": [
        "stack-demo-c-open-webui",
        "stack-demo-c-voice"
      ],
      "brain": "stack-demo-c-hermes",
      "idle_web": 600,
      "idle_brain": 600,
      "est_brain_mb": 600,
      "est_web_mb": 300
    }
  ],
  "max_parallel_boots": 1
}
