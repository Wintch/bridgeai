#!/bin/sh
# After a wake caused by the person's own Telegram message: the notices an always-on worker left for them (ops/worker_notices.py; the
# job moved out of the stack, workers/WORKERS.md), sent through the stack's own bot, after the night job summary (50-job-summary).
# A person at verbosity "critical" is not sent machinery notices (NOTICES.md). Nothing waiting = nothing sent.
[ "${WAKE_REASON:-}" = "telegram" ] && [ -n "${WAKE_CHAT_ID:-}" ] || exit 0
nohup /usr/bin/python3 "$HOME/aibridge/ops/worker_notices.py" wake --stack "$WAKE_NAME" --chat "$WAKE_CHAT_ID" --reason telegram --delay 15 \
  >>"$HOME/aibridge/ops/worker_notices.log" 2>&1 &
exit 0
