[Unit]
OnFailure=ops-alert@%n.service
Description=Collect bridgeai usage metadata (no message text) and alert on failed/empty/slow turns

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -w 120 %t/telemetry.lock /usr/bin/python3 %h/aibridge/ops/telemetry.py collect
ExecStartPost=-/usr/bin/python3 %h/aibridge/ops/lib/notify.py resolve unit:%n "%n volvió a funcionar"
