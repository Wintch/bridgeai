{
  "_comment": "Copy to ops/gateways.json on VM105 (untracked). Addresses only here. Then: python3 ops/gateways_sync.py. A host may also carry \"token\": the Bearer token its transcoder requires when TRANSCODE_TOKEN is set on that host",
  "hosts": {
    "gpu-desktop": {"addr": "<lan-ip>", "transcode": 8610, "upscale": 8600, "stt": 8620, "tts": 8640,
                     "llm": 8630, "llm_model": "gemma-4-e4b", "always_on": false, "gpu": "GTX 1070 Ti 8 GB"},
    "gpu-hq":      {"addr": "<lan-ip>", "tts": 8650, "always_on": false, "gpu": "RTX 3060 Ti 8 GB (Chatterbox only: list it BEFORE the Piper host in a stack's voice/gpu list, a host entry carries one tts port)"},
    "gpu-1660":    {"addr": "<lan-ip>", "transcode": 8610, "always_on": false, "gpu": "GTX 1660 6 GB"}
  },
  "stacks": {
    "hernik": {"gpu": ["gpu-desktop", "gpu-1660"]},
    "hereug": {"gpu": [], "voice": ["gpu-desktop"], "lang": "ru", "tts_voice": "<person>-{lang}", "tts_voices": ["<person>-ru", "<person>-es"], "claude": [{"name": "claude-box", "ssh_config": "/workdir/.ssh/config", "timeout": 900}]},
    "herand": {"voice": ["gpu-desktop"]},
    "ops-view": {"zabbix": {"url": "https://<zabbix>", "token": "<agent-<name> API token, read-only>", "group": "<default focus host group>"}}
  }
}
