{
  "_comment": "Copy to ops/gateways.json on the Docker host (untracked). Addresses only here. Then: python3 ops/gateways_sync.py. \"cloud_direct\": true on a stack sends every call straight to the cloud, no home model and no consent question (router.py); with it, \"cloud_mode\": \"explore\" starts each new conversation on another cloud model to evaluate them, and \"cloud_order\": [names] (from ops/model_scores.py) puts the best first. A host may also carry \"token\": the Bearer token its transcoder requires when TRANSCODE_TOKEN is set on that host. \"tareas\" (gateway tareas; ops/tareas_setup.py prints the entry; no token here, it goes in the stack's .env) is the task board between one person's bots: \"peers\" is who it may file for (downward only), \"accept_from\" whose tasks it reads and acts on (missing = peers; a list that is present is taken as written), \"max_cadena\" the chain depth for this owner (1 to 5, default 3). \"canal\" ({\"chat\": \"@ChannelName\" or \"-100...\", \"title\": \"...\", \"tz\": optional}; gateway canal, pack difusion) is the person's own Telegram channel, run by that stack's bot, which must be an administrator of the channel with post, edit and delete rights: the owner approves every post in their own chat. \"mosh\" (gpu-host/mosher, datamosh) is CPU only: any machine with Docker can run it, also the Docker host itself by container name (\"mosh_url\": \"http://mosher:8690\" on the stacks' network) \"job_decide\": {\"enabled\": true} on a stack (optional \"drop_below\": 0.15, \"key_env\": \"GEMINI_API_KEY\") turns on the optional job scoring in jobpush.py (Gemini Decision 1, the person's own key from the stack's .env, paid tier only: the free tier may use what is sent).",
  "hosts": {
    "gpu-a": {"addr": "<lan-ip>", "transcode": 8610, "upscale": 8600, "mosh": 8690, "mosh_token": "<set with ops/gateways_host_service.py HOST mosh 8690 --token-stdin>", "stt": 8620, "tts": 8640,
                     "llm": 8630, "llm_model": "gemma-4-e4b", "always_on": false, "gpu": "8 GB card: stt, tts, llm, transcode, upscale"},
    "gpu-hq":     {"addr": "<lan-ip>", "tts": 8650, "always_on": false, "gpu": "8 GB card for a GPU voice (list it BEFORE a CPU voice host in a stack's voice/gpu list: a host entry carries one tts port)"},
    "gpu-c":      {"addr": "<lan-ip>", "transcode": 8610, "always_on": false, "gpu": "6 GB card, video transcode only"},
    "gpu-d":      {"addr": "<lan-ip>", "image": 8660, "video": 8670, "vidpost": 8680, "image_token": "<set with ops/gateways_host_service.py HOST image 8660 --token-stdin>", "video_token": "<set with ops/gateways_host_service.py HOST video 8670 --token-stdin>", "vidpost_token": "<set with ops/gateways_host_service.py HOST vidpost 8680 --token-stdin>", "always_on": false, "gpu": "large-VRAM card: imggen (image) and vidgen (video, one clip at a time, minutes per clip), vidpost (smoother 48 fps and 2x larger clips, one at a time)"}
  },
  "stacks": {
    "stack-a": {"gpu": ["gpu-a", "gpu-c", "gpu-d"]},
    "stack-b": {"gpu": [], "voice": ["gpu-a"], "lang": "<es|ru|en>", "tts_voice": "<person>-{lang}", "tts_voices": ["<person>-ru", "<person>-es"], "claude": [{"name": "<claude-host>", "ssh_config": "/workdir/.ssh/config", "timeout": 900}],
               "web": {"repo": "ssh://gitea-web/<owner>/<repo>.git", "url": "https://<site>", "branch": "main", "images": {"full": "<folder>", "thumb": "<folder>"}}},
    "stack-c": {"voice": ["gpu-a"]},
    "stack-d": {"tareas": {"url": "https://<gitea-host>[:port]", "repo": "<org>/tareas", "me": "bot-<stack>", "peers": ["bot-<the stack below this one>"], "accept_from": ["bot-<neighbours whose tasks this one acts on>"], "max_cadena": 3, "humans": ["<owner's Gitea user>"]}},
    "stack-e": {"canal": {"chat": "@<ChannelName>", "title": "<Channel name>"}},
    "stack-f": {"zabbix": {"url": "https://<zabbix>", "token": "<agent-<name> API token, read-only>", "group": "<default focus host group>"}},
    "stack-g": {"maquinas": {"url": "https://<machine-power-provider>/v1", "key": "<this person's key, role client, named as their account>",
                                    "credit": "none (\"backend\" once the provider reports per-person credit)", "max_wakes_day": 3,
                                    "machines": {"<alias>": {"mac": "<mac>", "remote": {"kind": "moonlight", "host": "<host the person's Moonlight pairs with>"}}}}}
  }
}
