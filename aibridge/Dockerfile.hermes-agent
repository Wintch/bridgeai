# syntax=docker/dockerfile:1
# App layer only -- the system package set + tirith now live in
# Dockerfile.hermes-agent-base (2026-10-01 split, see that file's header).
# This keeps the common case (editing a SKILL_*.md, start_hermes.sh, or
# bumping the commit pin below) from re-running the ~2min apt step every
# time. Build the base at least once before this:
#   docker build -f Dockerfile.hermes-agent-base -t aibridge-hermes-base:latest .
FROM aibridge-hermes-base:latest
# Pinned to the exact commit already tested and running (2026-10-01), not
# "whatever Nous currently serves as latest" -- supply-chain hardening:
# a hijacked maintainer account publishing a malicious update can't reach
# this build until the pin is deliberately bumped by hand. Bump by running
# `cd /root/.hermes/hermes-agent && git rev-parse HEAD` in a working
# container and updating the SHA below. (The first value tried here,
# 895b506e, was ALREADY STALE by the time this line was added -- an
# un-pinned rebuild in between had silently moved the running commit
# forward to this one, proving exactly the drift this pin exists to stop.)
# Cache mounts for the installer's own Python (uv) and Node package
# downloads -- speeds up future commit-pin bumps, since most dependency
# versions stay the same between two nearby commits and won't need
# re-fetching from PyPI/npm each time. Harmless if a path guess is wrong
# (just an unused empty cache dir, no effect on the install itself).
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    --mount=type=cache,target=/root/.npm,sharing=locked \
    curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash -s -- --commit 818c13be1dc4fd28987e1e881a9408224afd4535
ENV PATH="/root/.local/bin:${PATH}"
# v0.21.6 moved Telegram out of the `all` extra (installed "on first use", which silently fails at gateway start:
# "Platform 'Telegram' requirements not met"). Bake python-telegram-bot into the venv at build time.
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    hermes pm install --extra telegram
# Local patch to Hermes's Telegram adapter (2026-10-04): big files go through
# disk instead of RAM, and the media-send timeouts become env-configurable.
# The script aborts the build if the pinned Hermes code no longer matches, so
# bumping the commit pin above forces a conscious re-check of the patch.
COPY patches/telegram_large_files.py /tmp/telegram_large_files.py
RUN python3 /tmp/telegram_large_files.py /root/.hermes/hermes-agent/plugins/platforms/telegram/adapter.py \
    && python3 -m py_compile /root/.hermes/hermes-agent/plugins/platforms/telegram/adapter.py \
    && rm /tmp/telegram_large_files.py
# Second patch (2026-10-06): the adapter ignored round videos (video notes).
COPY patches/telegram_video_note.py /tmp/telegram_video_note.py
RUN python3 /tmp/telegram_video_note.py /root/.hermes/hermes-agent/plugins/platforms/telegram/adapter.py \
    && python3 -m py_compile /root/.hermes/hermes-agent/plugins/platforms/telegram/adapter.py \
    && rm /tmp/telegram_video_note.py
WORKDIR /workdir
COPY responder_hermes.py /app/responder_hermes.py
COPY start_hermes.sh /app/start_hermes.sh
COPY SOUL_bridgeai.md /app/SOUL_bridgeai.md
COPY router.py /app/router.py
COPY SKILL_network_diagnostics.md /root/.hermes/skills/devops/network-diagnostics/SKILL.md
COPY SKILL_image_upscale.md /root/.hermes/skills/devops/image-upscale/SKILL.md
COPY SKILL_project_workspace.md /root/.hermes/skills/devops/project-workspace/SKILL.md
COPY SKILL_audio_transcription.md /root/.hermes/skills/devops/audio-transcription/SKILL.md
COPY SKILL_audio_identify.md /root/.hermes/skills/devops/audio-identify/SKILL.md
COPY SKILL_davinci_resolve.md /root/.hermes/skills/devops/davinci-resolve/SKILL.md
COPY SKILL_web_interface.md /root/.hermes/skills/devops/web-interface/SKILL.md
COPY SKILL_job_notify.md /root/.hermes/skills/devops/job-notify/SKILL.md
COPY SKILL_cron_policy.md /root/.hermes/skills/devops/cron-policy/SKILL.md
COPY SKILL_job_search.md /root/.hermes/skills/devops/job-search/SKILL.md
COPY SKILL_gpu_transcode.md /root/.hermes/skills/devops/gpu-transcode/SKILL.md
COPY SKILL_media_bench.md /root/.hermes/skills/devops/media-bench/SKILL.md
COPY SKILL_video_understanding.md /root/.hermes/skills/media/video-understanding/SKILL.md
COPY SKILL_video_processing.md /root/.hermes/skills/media/video-processing/SKILL.md
# One door to GPU boxes and Claude machines; logs metadata for the operator's telemetry (gateway.py docstring).
COPY gateway.py /usr/local/bin/gateway
RUN chmod 755 /usr/local/bin/gateway
COPY jobwatch.py /root/.hermes/scripts/jobwatch.py
COPY keys_server.py keys_page.html doc_extractor.py /app/
COPY browse-page.cjs /usr/local/bin/browse-page
COPY buscar-empleos.cjs /usr/local/bin/buscar-empleos
RUN chmod 755 /usr/local/bin/browse-page /usr/local/bin/buscar-empleos
RUN chmod +x /app/start_hermes.sh
CMD ["/app/start_hermes.sh"]
