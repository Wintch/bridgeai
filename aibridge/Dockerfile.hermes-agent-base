# syntax=docker/dockerfile:1
# Stable "tools" layer for hermes-agent, split out of Dockerfile.hermes-agent
# so that touching a SKILL_*.md file, start_hermes.sh, or
# bumping the Hermes commit pin no longer forces a ~2min redo of apt and the
# browser installs -- those only change when the package list itself does
# (heat-map driven, see HERMES_ARCHITECTURE.md "Tool gaps"). Unlike plain
# BuildKit cache mounts (soft, can be GC'd under disk pressure), this is a
# real tagged image that persists in `docker images` like any other.
#
# Rebuild this ONLY when adding/removing a system package or bumping
# a pinned tool, then rebuild the app image on top of it:
#   docker build -f Dockerfile.hermes-agent-base -t aibridge-hermes-base:latest .
#   docker compose build hermes-agent
#
# Base image pinned by digest, not the floating `24-trixie-slim` tag, for the
# same reason as the Hermes commit pin in Dockerfile.hermes-agent: an upstream
# republish shouldn't silently change what this starts from. Re-resolve
# with `docker buildx imagetools inspect node:24-trixie-slim` to bump.
# Node 24 (was node:20-slim, out of support): Hermes asks for
# ^22.22 || ^24.11 and career-ops for ^22.13. `trixie` is explicit so the OS
# stays Debian 13 (security/DEBIAN13_MIGRATION.md); digest of 2026-11-11, Node 24.22.3.
# The trixie digest has not been Trivy-scanned yet (ops/image_audit.sh --trivy); image_audit warns when the digest moves again.
FROM node:24-trixie-slim@sha256:af02d57b57719b9657a45199a79264a9437940cd55b3c7b3fc99615654f124a0

# RUN --mount=type=cache persists apt's .deb files and package lists in a
# BuildKit cache volume, outside the image layer -- survives even when this
# package list changes, so adding one more tool doesn't mean re-fetching
# everything already here over the network.
#
# gh: baked in after Hermes installed it live via `apt-get install -y -qq
# gh` mid-conversation (heat-map tracking, HERMES_ARCHITECTURE.md "Tool
# gaps", fourth round). Not authenticated (no GH_TOKEN) -- separate,
# deliberately-deferred credential decision.
# sudo: first added as a dependency of tirith's .deb (tirith is gone); kept because agents prefix commands with sudo
# out of habit, and as root it just runs them.
# iproute2/ethtool/brotli: fifth heat-map round, see HERMES_ARCHITECTURE.md
# -- iproute2 fixes a real gap in SKILL_network_diagnostics.md's own
# pre-work checklist (it calls `ip`, which was never installed).
# tesseract-ocr: OCR (text recognition in images), operator-requested
# for design-work use cases. Debian's 5.3.0-2 is current enough
# -- unlike yt-dlp, Tesseract doesn't chase live site changes, so there's
# no real staleness risk in taking Debian's security-patched package
# as-is. eng+spa language packs (the operator works in Spanish).
#
# fonts-liberation2/fonts-noto-core/fonts-urw-base35/fonts-dejavu: free
# fonts for design/image work via ImageMagick or anything else that
# renders text. Static content, not security-sensitive the way a parser
# or codec is -- no reason to chase a newer-than-apt source here either.
# (fonts-noto-core in apt is a 2020 snapshot, missing some newer Unicode
# additions -- noted, not worth the integration complexity of a separate
# pinned source for a non-security-relevant staleness gap.)
#
# ffmpeg: deliberately KEPT as Debian's package (7.1 on trixie), not swapped for a
# newer static build -- checked first: it already ships full
# AV1 encoder support (libaom-av1, librav1e, libsvtav1 all compiled in,
# confirmed via `ffmpeg -encoders`), which was the operator's actual
# concern. A static upstream build would trade Debian's security-patch
# pipeline for a newer point-release with no concrete use case here that
# needs it -- not a good trade under "seguridad, luego performance".
# graphviz (`dot`): DOT-language diagram rendering, operator-requested
# Debian's graphviz is not the newest but DOT itself barely changes and
# there's no untrusted-input parsing concern for diagrams we generate
# ourselves -- apt is fine here, same reasoning as tesseract.
# poppler-utils (`pdftoppm`/`pdftotext`/etc.): PDF inspection/manipulation.
# Deliberately KEPT on Debian's security channel, not swapped for
# anything newer -- this parses PDF content that could come from a user,
# so the security-patch pipeline matters more than version recency here
# ("seguridad, luego performance" -- this is the "seguridad" case).
# Cache-bust for the Debian security-channel packages below (ffmpeg,
# tesseract-ocr, poppler-utils) that this layer takes "as-is, trust apt" per
# the reasoning in each comment above. `apt-get update` genuinely re-fetches
# the index on every build that actually RUNS it -- but Docker's layer cache
# keys off this instruction's exact TEXT, not what apt would return: if the
# package list hasn't changed, the layer is reused without running apt-get at
# all, so a new point-release never gets pulled in just because time passed.
# Rule: a fix for a package in this layer only sticks when the layer is rebuilt
# (a live apt upgrade inside a running container is gone at the next recreate),
# so after a Debian security update for one of these packages, bump the date below.
# Bump it also whenever this base needs a real re-pull of its apt packages (not only when
# the package LIST itself changes, which already invalidates the layer).
ARG SECURITY_REFRESH=2026-11-15
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    echo "security refresh: $SECURITY_REFRESH" && apt-get update && apt-get install -y --no-install-recommends curl wget ca-certificates git python3 python3-pil python3-pip libatomic1 iputils-ping traceroute bind9-dnsutils mtr-tiny nmap tcpdump openssh-client file imagemagick bc sqlite3 ffmpeg libchromaprint-tools gh sudo iproute2 ethtool brotli tesseract-ocr tesseract-ocr-eng tesseract-ocr-spa fonts-liberation2 fonts-noto-core fonts-urw-base35 fonts-dejavu graphviz poppler-utils xz-utils libheif-plugin-aomenc python3-numpy \
    && convert -size 8x8 xc:red avif:/tmp/t.avif && identify /tmp/t.avif && rm -f /tmp/t.avif

# PDF create/read stack, for the web UI and the bundled `pdf` skill, which expects
# pypdf + reportlab + pdfplumber and calls `python` (Debian only ships `python3`, hence
# python-is-python3). weasyprint is the HTML->PDF engine for `pandoc --pdf-engine=weasyprint`
# (pandoc below has no LaTeX engine, deliberately: texlive is multiple GB). qpdf for
# merge/linearize/encrypt. All from Debian's security channel except pdfplumber/pypdfium2,
# which have no Debian package: pinned pip versions.
# ripgrep + uuid-runtime: Hermes's `search_files` refuses broad searches without `rg`, and
# skills/agents call `uuidgen` for /web-outputs dirs; both failed repeatedly.
# edge-tts: `gateway speak`'s cloud fallback (aibridge/gateway.py cmd_speak)
# looked for this binary but it was never actually installed anywhere in the image, so the
# fallback silently never worked; found after a real outage where every home TTS host was
# down at once and this "fallback" turned out to be a no-op too.
# pdfplumber pulls cryptography 50, which wants cffi 2: pip puts it in /usr/local in front of Debian's (as on Debian 12). Trixie's
# python3-cffi has no RECORD file, so pip cannot "uninstall" it first: cffi goes in alone with --ignore-installed.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends python-is-python3 python3-pypdf python3-reportlab python3-markdown weasyprint qpdf ripgrep uuid-runtime procps \
    && pip install --no-cache-dir --break-system-packages --ignore-installed cffi==2.1.1 \
    && pip install --no-cache-dir --break-system-packages pdfplumber==0.11.10 pypdfium2==5.15.2 edge-tts==7.3.1

# pandoc: document conversion (Markdown/HTML/docx/ODF/... -> PDF and back),
# requested explicitly. NOT the apt package (2.17.1, from 2022) --
# pinned official static release instead, same reasoning as yt-dlp: a real
# 2-major-version functional gap, and pandoc publishes self-contained
# Linux binaries, so pinning is just as clean as apt would be. Hash
# computed directly from the downloaded release artifact (project doesn't
# publish a separate checksums file) -- still catches any later tampering
# of that URL, as a published checksums file would.
RUN curl -fsSL -o /tmp/pandoc.tar.gz https://github.com/jgm/pandoc/releases/download/3.14/pandoc-3.14-linux-amd64.tar.gz \
    && echo "c5f4720cdefb3f7bdc5d07202ef579feef0d1370773c873804dd8fdaa8c4f1b8  /tmp/pandoc.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/pandoc.tar.gz -C /usr/local --strip-components=1 pandoc-3.14/bin/pandoc \
    && rm /tmp/pandoc.tar.gz

# typst: modern, fast, single-binary PDF typesetting (a LaTeX alternative)
# -- chosen over installing full texlive, which is multiple GB and the
# wrong fit for a 768MB-limited container (same "heavy stuff doesn't
# belong in this container" principle as the GPU heavy-tools-host split).
# Pinned release + self-computed hash, same pattern as pandoc above.
RUN curl -fsSL -o /tmp/typst.tar.xz https://github.com/typst/typst/releases/download/v0.15.1/typst-x86_64-unknown-linux-musl.tar.xz \
    && echo "a6d077d0a95eed5a2eba715b2dae06be954f624ccbf85758a03f389ded33118c  /tmp/typst.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/typst.tar.xz -C /usr/local/bin --strip-components=1 typst-x86_64-unknown-linux-musl/typst \
    && rm /tmp/typst.tar.xz

# yt-dlp is NOT here any more: it is bumped every few weeks, and a step in this file that changes rebuilds
# everything after it (Chromium for Playwright, the apt packages). It lives in Dockerfile.hermes-agent now,
# in a one-binary layer, so a bump is seconds and never needs REBUILD_BASE=1.

# tirith (a pre-exec command scanner) was removed on 2026-11-15: Hermes dropped its tirith integration (config migration
# 50 deletes security.tirith_*; its security docs: "enables nothing in its place"), so the binary was installed and never run.
# Hermes's own dangerous-command patterns and approvals still apply.

# Headless Chromium for Playwright, baked in so every instance has it: the jobfinder (career-ops) renders
# CVs to PDF with it and reads JS-heavy job pages, and Hermes can use it for screenshots. Version pinned to what
# the jobfinder's package-lock.json uses so its node_modules finds the matching browser build (each Playwright
# release looks for exactly one Chromium revision under PLAYWRIGHT_BROWSERS_PATH).
# Playwright's Chromium is bundled, so Debian never patches it: a browser fix means a Playwright bump. 1.65.x
# (1.65.0: Chromium 158, the first with the fix for a use-after-free CISA lists as exploited, added 2026-11-10; 1.65.1:
# Chromium 159, revision 1255). TRANSITION: the jobfinder lock still pins 1.64.1, so its Chromium (revision 1248)
# is installed too until the lock moves to 1.65.1 and has synced to every stack; then drop the second install.
# Installed system-wide under /opt/ms-playwright (not per-user cache). `--with-deps` pulls the apt libs it needs.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
# The global playwright package is found by `require` only inside a project that has its own copy; without NODE_PATH a
# script outside /workdir/jobfinder fails with MODULE_NOT_FOUND and the agent concludes Playwright is missing.
ENV NODE_PATH=/usr/local/lib/node_modules
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    npm install -g playwright@1.65.1 && playwright install --with-deps chromium \
    && npx --yes playwright@1.64.1 install chromium && rm -rf /root/.npm/_npx \
    && chmod -R a+rX /opt/ms-playwright

# Tools the models kept installing at runtime (a review of every terminal call in the state databases). A
# runtime apt/pip install lives in the container layer and is gone after the next recreate, so the same install (and
# its approval prompt) came back each time. Each one is here because the logs show it was needed, not "just in case":
# - aria2: torrents and big files; apt-installed live more than once; `gateway bajar` runs it (no seeding).
# - zbar-tools (`zbarimg`): QR codes on street photos, a skill people use; installed live (zbar-tools, pyzbar), and cv2 was missing 4 times for the same job.
# - tesseract-ocr-rus: "Failed loading language 'rus'" once, installed live; users read Russian.
# - python3-bs4, python3-requests: "No module named bs4/requests" 6 times in scripts that parse a fetched page.
# - python3-mutagen: audio tags, pip-installed live twice.
# - python3-yaml: a script reading a YAML config died on "No module named 'yaml'", and pip is refused (PEP 668), so the
#   agent could not fix it itself; unzip: "command not found" 3 times.
# - libegl1, libegl-mesa0: a Blender 5.x download in the workdir died at start on a missing libEGL.so.1 (even for a
#   CPU-only Cycles render in -b mode); the rest of Mesa (libGL, GLX, DRI) was already here for Chromium. A few hundred KB.
# Left out on purpose: OpenCV (~100+ MB; zbarimg covers QR, numpy/scipy/PIL/imagemagick cover the image work it was
# used for), Whisper/torch/speech_recognition (pip-tried 3 times: speech never runs on the VM CPU, `gateway transcribe`
# does it), TeX for pandoc (failed 5 times for "pdflatex not found": use --pdf-engine=weasyprint or typst, both here).
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends aria2 zbar-tools tesseract-ocr-rus python3-bs4 python3-requests python3-mutagen python3-yaml unzip libegl1 libegl-mesa0
