# Sesame CSM-1B (Apache-2.0 weights, also needs gated meta-llama/Llama-3.2-1B). Built only to compare by ear
# against Chatterbox with the default voice on both sides, no cloning: the model's own card says it is English,
# with non-English ability "likely poor" from incidental data contamination -- not a candidate for es/ru replies,
# this is purely a quality check. Needs HF_TOKEN at `docker run`, from an account with access GRANTED (gated,
# request first at huggingface.co/sesame/csm-1b and huggingface.co/meta-llama/Llama-3.2-1B) to both repos.
FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg git && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 https://github.com/SesameAILabs/csm.git /app/csm
WORKDIR /app/csm
RUN pip install --no-cache-dir -r requirements.txt soundfile
ENV NO_TORCH_COMPILE=1
ENV HF_HOME=/models
COPY server_csm.py /app/csm/server.py
EXPOSE 5002
CMD ["python3", "/app/csm/server.py"]
