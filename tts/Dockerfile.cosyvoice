# Fun-CosyVoice3-0.5B (FunAudioLLM, Apache-2.0, 9 languages incl. es and ru, streaming capable). Same API shape as the other
# tts/ services. Needs a reference clip per voice (/voices/<name>.wav; es.wav, ru.wav, en.wav answer voice "auto").
# deepspeed, tensorrt, gradio and tensorboard are left out of requirements.txt: inference does not need them and they are the
# packages that fail to build. The repo is cloned at the commit given by COSYVOICE_REF (default: main; record the commit that worked).
FROM pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime
ARG COSYVOICE_REF=main
RUN apt-get update && apt-get install -y --no-install-recommends git ffmpeg sox libsox-dev libsndfile1 curl build-essential && rm -rf /var/lib/apt/lists/*
RUN git clone --recursive https://github.com/FunAudioLLM/CosyVoice.git /opt/CosyVoice \
 && cd /opt/CosyVoice && git checkout "$COSYVOICE_REF" && git submodule update --init --recursive && git rev-parse HEAD > /opt/cosyvoice.commit
WORKDIR /opt/CosyVoice
# openai-whisper 20231117 does not build in an isolated env (needs the old setuptools): install it first without isolation
RUN pip install --no-cache-dir 'setuptools<70' wheel && pip install --no-cache-dir --no-build-isolation openai-whisper==20231117
RUN grep -viE '^(deepspeed|tensorrt|gradio|tensorboard|grpcio)' requirements.txt > /tmp/req.txt \
 && pip install --no-cache-dir -r /tmp/req.txt huggingface_hub soundfile
ENV HF_HOME=/models PYTHONPATH=/opt/CosyVoice:/opt/CosyVoice/third_party/Matcha-TTS
COPY server_cosyvoice.py /app/server.py
EXPOSE 5002
CMD ["python3", "/app/server.py"]
