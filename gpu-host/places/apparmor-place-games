# AppArmor profile for a place that runs Steam games (create|recreate --games). It is Docker's own docker-default profile with ONE change: `mount`,
# `pivot_root` and `userns` (creating a user namespace) are allowed, because bubblewrap (Steam runtime, Proton) mounts inside the user namespace it creates for itself. Everything else docker-default
# denies stays denied: writes to /proc/sys and most of /sys, /proc/kcore, /proc/sysrq-trigger, /sys/firmware, /sys/kernel/security.
# Installed (root, once) by install-games-profile.sh as /etc/apparmor.d/bridgeai-place-games.
#include <tunables/global>

profile bridgeai-place-games flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  mount,
  pivot_root,
  userns,

  signal (receive) peer=unconfined,
  signal (receive) peer=bridgeai-place-games,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read,tracedby,readby) peer=bridgeai-place-games,
}
