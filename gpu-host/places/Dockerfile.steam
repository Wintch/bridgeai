# Steam and its 32-bit runtime on top of the Sunshine image: the place for a person's game library (create|recreate --games, which also gives the container
# the narrow user-namespace profile Steam's runtime and Proton need; see PLACES.md, "Games").
#   build-steam.sh [BASE_IMAGE] [TAG]     builds bridgeai-place-steam:latest
# Steam is Debian's own steam-installer package (non-free), so apt checks it; the client itself downloads its updates into the person's folder at first start.
# The 32-bit NVIDIA libraries are NOT in the image: the NVIDIA runtime mounts the host's own once the image has the i386 architecture.
ARG BASE=bridgeai-place-sunshine:latest
FROM ${BASE}
USER root
RUN set -eux; \
    dpkg --add-architecture i386; \
    printf 'Types: deb\nURIs: http://deb.debian.org/debian\nSuites: trixie trixie-updates\nComponents: main contrib non-free non-free-firmware\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' > /etc/apt/sources.list.d/bridgeai-nonfree.sources; \
    echo 'steam steam/question select I AGREE' | debconf-set-selections; echo 'steam steam/license note' | debconf-set-selections; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends steam-installer libc6:i386 libgl1:i386 libvulkan1:i386 libgl1-mesa-dri:i386 mesa-vulkan-drivers:i386 libgl1-mesa-dri mesa-vulkan-drivers vulkan-tools pciutils xdg-utils; \
    # Steam's own browser (the whole client UI) draws only a black window on the place's virtual X display unless it skips the GPU; games still use the card
    printf '#!/bin/sh\nexec /usr/games/steam -cef-disable-gpu "$@"\n' > /usr/local/bin/steam; chmod 755 /usr/local/bin/steam; \
    sed -i 's#^Exec=/usr/games/steam#Exec=/usr/local/bin/steam#' /usr/share/applications/steam.desktop; \
    apt-get clean; rm -rf /var/lib/apt/lists/*
# Epic Games (and GOG, Amazon) through Heroic Games Launcher, the open-source client: the pinned release .deb, checked against its sha256. Its games run
# under Proton/Wine with the same runtime Steam uses. Electron's own sandbox cannot start under no-new-privileges: the launcher gets --no-sandbox (the
# container is the sandbox), like Brave.
ARG HEROIC_VERSION=2.22.4
ADD --checksum=sha256:46aa36778f16d98a86823fc42fcb7ef47efab346ff19380165201aa373ebf70a https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher/releases/download/v${HEROIC_VERSION}/Heroic-${HEROIC_VERSION}-linux-amd64.deb /tmp/heroic.deb
RUN set -eux; apt-get update; DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends /tmp/heroic.deb; rm -f /tmp/heroic.deb; \
    printf '#!/bin/sh\nexec /opt/Heroic/heroic --no-sandbox "$@"\n' > /usr/local/bin/heroic; chmod 755 /usr/local/bin/heroic; \
    sed -i 's#^Exec=/opt/Heroic/heroic#Exec=/usr/local/bin/heroic#' /usr/share/applications/heroic.desktop; grep -q '^Exec=/usr/local/bin/heroic' /usr/share/applications/heroic.desktop; \
    apt-get clean; rm -rf /var/lib/apt/lists/*
# The Quake III Arena demo on ioquake3 (contrib): game-data-packager fetches id Software's free demo from the vendor's mirror and builds the data package,
# then is removed again. Two places can play it against each other over the LAN (PLACE_GAME_UDP, place.py --udp 27960; PLACES.md).
COPY quake3-demo /usr/local/bin/quake3-demo
COPY quake3-demo.desktop /usr/share/applications/quake3-demo.desktop
COPY quake3-demo-window.desktop /usr/share/applications/quake3-demo-window.desktop
RUN set -eux; chmod 755 /usr/local/bin/quake3-demo; apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ioquake3 game-data-packager; \
    mkdir -p /tmp/q3; /usr/games/game-data-packager quake3 --demo -d /tmp/q3 --no-search --download; \
    dpkg -i /tmp/q3/quake3-demo-data_*_all.deb; rm -rf /tmp/q3; \
    DEBIAN_FRONTEND=noninteractive apt-get purge -y --auto-remove game-data-packager; \
    test -d /usr/lib/quake3/demo/demoq3; apt-get clean; rm -rf /var/lib/apt/lists/*
