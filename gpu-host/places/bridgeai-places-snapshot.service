[Unit]
Description=bridgeai desktop places: a daily btrfs snapshot of every place, then old snapshots pruned and the games inventory written
After=local-fs.target
# Installed by the operator like the other units of this folder: place.py copied (not linked: root must not run a file a user can change) as
# /usr/local/sbin/bridgeai-place, this unit and its .timer in /etc/systemd/system, then `systemctl enable --now bridgeai-places-snapshot.timer`.
# PLACES_ROOT and PLACE_SNAPSHOT_DAYS come from /etc/default/bridgeai-places when set there. Only places are snapshotted: the "library" subvolume,
# links and folders without .desktop.env are skipped; a place that is not a btrfs subvolume (the old layout) gets a line saying so. No network:
# docker is only asked, over its local socket, whether each place runs. A snapshot of a running place is taken as it is (instant, no data
# written): crash-consistent, like a power cut, and recorded as such beside it.

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=full
# $$ is a literal $ for the shell (systemd would expand $NAME itself); no % in the command (systemd reads it as a specifier)
ExecStart=/bin/bash -c 'PLACES_ROOT=$${PLACES_ROOT:-/srv/bridgeai/places}; conf=$${PLACES_CONF:-/etc/default/bridgeai-places}; \
  [ -f "$$conf" ] && . "$$conf"; export PLACES_ROOT PLACE_SNAPSHOT_DAYS; py=$${PLACE_PY:-/usr/local/sbin/bridgeai-place}; rc=0; \
  for d in "$$PLACES_ROOT"/*/; do n=$$(basename "$$d"); d=$$PLACES_ROOT/$$n; [[ $$n =~ ^[a-z][a-z0-9]{1,11}$$ ]] && [ "$$n" != library ] || continue; \
    [ ! -L "$$d" ] && [ -f "$$d/.desktop.env" ] || continue; \
    btrfs subvolume show "$$d" >/dev/null 2>&1 || { echo "$$n: not a btrfs subvolume (old layout): no snapshot"; continue; }; \
    "$$py" snapshot "$$n" --reason daily || rc=1; done; \
  "$$py" prune || rc=1; "$$py" inventory || rc=1; exit $$rc'
