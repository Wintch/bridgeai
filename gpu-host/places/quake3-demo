#!/bin/sh
# quake3-demo [ARGS]: the Quake III Arena demo (id Software's free demo data, packaged at image build by Debian's game-data-packager) on ioquake3, in a window.
# Host a game: Multiplayer -> Create; join one: Multiplayer -> Specify, ADDRESS:27960 (another place answers on its own LAN address when it publishes 27960/udp).
export __GLX_VENDOR_LIBRARY_NAME=nvidia
cd /usr/lib/ioquake3 || exit 1
exec ./ioquake3 +set fs_basepath /usr/lib/quake3/demo +set fs_homepath "$HOME/.q3a" +set com_basegame demoq3 \
  +set r_mode -1 +set r_customwidth 1280 +set r_customheight 720 +set r_fullscreen 0 +set com_maxfps 125 +set cl_allowDownload 0 "$@"
