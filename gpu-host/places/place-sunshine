#!/bin/sh
# Runs inside the person's desktop session (XFCE autostart), as the person's own user: Sunshine on the place's own ports.
# Does nothing unless the container was created with --sunshine (SUNSHINE_PORT). Its admin page answers only from localhost (origin_web_ui_allowed = pc) and is
# never published; `place.py pair NAME PIN` gives it the PIN Moonlight shows.
[ -n "${SUNSHINE_PORT:-}" ] || exit 0
CONF="$HOME/.config/sunshine"
mkdir -p "$CONF"
cat > "$CONF/sunshine.conf" <<CFG
port = ${SUNSHINE_PORT}
address_family = ipv4
sunshine_name = ${SUNSHINE_NAME:-place}
origin_web_ui_allowed = pc
origin_pin_allowed = pc
upnp = off
encoder = nvenc
capture = x11
min_log_level = info
CFG
# The apps Moonlight lists: the desktop, sized to the client first (place-sunshine-res), and Steam's Big Picture where Steam is installed.
# Rewritten on every start (the package's default list points at an HDMI output a place does not have).
STEAM_APP=""
command -v steam >/dev/null 2>&1 && STEAM_APP=',
  {"name": "Steam Big Picture", "image-path": "steam.png", "prep-cmd": [{"do": "/usr/local/bin/place-sunshine-res", "undo": "setsid steam steam://close/bigpicture"}],
   "detached": ["setsid steam steam://open/bigpicture"]}'
cat > "$CONF/apps.json" <<APPS
{"env": {"PATH": "\$(PATH):\$(HOME)/.local/bin"}, "apps": [
  {"name": "Desktop", "image-path": "desktop.png", "prep-cmd": [{"do": "/usr/local/bin/place-sunshine-res", "undo": ""}]}${STEAM_APP}
]}
APPS
# Sunshine runs WITHOUT the session's LD_PRELOAD. Selkies' input interposer catches open("/dev/uinput") and turns Sunshine's keyboard and mice into
# Selkies' own virtual devices (/dev/input/event300x), which the X server never reads: Moonlight then shows the desktop but mouse and keys do nothing.
# Without it, /dev/uinput is absent, so Sunshine falls back to XTEST, which goes straight into the X display.
unset LD_PRELOAD
[ -n "${SUNSHINE_ADMIN_PASS:-}" ] && sunshine --creds admin "${SUNSHINE_ADMIN_PASS}" >/dev/null 2>&1
while :; do
  sunshine "$CONF/sunshine.conf" >> "$CONF/sunshine.log" 2>&1
  sleep 5
done
