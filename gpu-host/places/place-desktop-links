#!/usr/bin/env python3
"""place-desktop-links [--watch SECONDS]: one icon on the place's desktop per thing the person can start, so a click in the browser starts it.

- The place's own launchers, where the image has them: Steam, Heroic, the Quake III demo, Resolve, Force-close game.
- One icon per game installed in Steam (every library in libraryfolders.vdf; Proton, the runtimes and the redistributables are left out), started
  with steam://rungameid/ID, with Steam's own icon of the game when there is one.
- One icon per Epic game installed through Heroic (legendary's installed.json), started through Heroic's launch link.
- The same games in Moonlight's list for this place (Sunshine's apps.json, with the game's portrait art as its cover), when the place has Sunshine.

Only files named bridgeai-*.desktop are written or removed, so the person's own icons are never touched; an uninstalled game's icon goes away.
Each launcher is marked trusted for Xfce (executable + the checksum Xfce keeps in the file's metadata), so a click starts it with no warning.
Runs from the session's autostart with --watch 60, so a game installed later gets its icon within a minute.
"""
import glob, hashlib, json, os, re, subprocess, sys, time

HOME = os.path.expanduser("~")
STEAM_ROOTS = [os.path.join(HOME, ".steam", "debian-installation"), os.path.join(HOME, ".local", "share", "Steam"), os.path.join(HOME, ".steam", "steam")]
SYSTEM = ["steam.desktop", "heroic.desktop", "quake3-demo.desktop", "kill-game.desktop"]
NOT_GAMES = re.compile(r"^(Proton|Steam Linux Runtime|Steamworks Common)|Redistributable", re.I)
PREFIX = "bridgeai-"
GAMES = []                                          # filled by wanted(): what Moonlight's app list should offer
SUN_DIR = os.path.join(HOME, ".config", "sunshine")
OURS = ("steam://rungameid/", "heroic://launch")      # an app in Sunshine's list with one of these in its command is ours to keep current


def desktop_dir():
    try:
        d = subprocess.run(["xdg-user-dir", "DESKTOP"], capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        d = ""
    return d if d and d != HOME else os.path.join(HOME, "Desktop")


def vdf_values(text, key):
    return re.findall(r'"%s"\s+"([^"]*)"' % re.escape(key), text)


def steam_libraries():
    libs = []
    for root in STEAM_ROOTS:
        for vdf in (os.path.join(root, "steamapps", "libraryfolders.vdf"), os.path.join(root, "config", "libraryfolders.vdf")):
            try:
                libs += vdf_values(open(vdf, encoding="utf-8", errors="replace").read(), "path")
            except OSError:
                pass
        libs.append(root)
    seen, out = set(), []
    for lib in libs:
        real = os.path.realpath(lib)
        if real not in seen and os.path.isdir(os.path.join(real, "steamapps")):
            seen.add(real)
            out.append(real)
    return out


def steam_icon(appid):
    for size in ("256x256", "128x128", "96x96", "64x64", "48x48", "32x32", "16x16"):
        p = os.path.join(HOME, ".local", "share", "icons", "hicolor", size, "apps", f"steam_icon_{appid}.png")
        if os.path.isfile(p):
            return p
    for root in STEAM_ROOTS:
        for name in ("logo.png", "library_600x900.jpg", "header.jpg"):
            p = os.path.join(root, "appcache", "librarycache", appid, name)
            if os.path.isfile(p):
                return p
    return "steam"


def clean(text):
    return re.sub(r"[\x00-\x1f]", " ", text).strip()[:120]


def entry(name, exec_line, icon, comment=""):
    return ("[Desktop Entry]\nType=Application\nVersion=1.0\n"
            f"Name={clean(name)}\nExec={exec_line}\nIcon={icon}\nTerminal=false\n" + (f"Comment={clean(comment)}\n" if comment else ""))


def wanted():
    out = {}
    GAMES.clear()
    apps = "/usr/share/applications"
    for f in SYSTEM + [os.path.basename(p) for p in glob.glob(os.path.join(apps, "*[Rr]esolve*.desktop"))]:
        src = os.path.join(apps, f)
        if os.path.isfile(src):
            out[PREFIX + f] = open(src, encoding="utf-8", errors="replace").read()
    for lib in steam_libraries():
        for acf in glob.glob(os.path.join(lib, "steamapps", "appmanifest_*.acf")):
            try:
                text = open(acf, encoding="utf-8", errors="replace").read()
            except OSError:
                continue
            appid, name, flags = (vdf_values(text, "appid") or [""])[0], (vdf_values(text, "name") or [""])[0], (vdf_values(text, "StateFlags") or ["0"])[0]
            if not appid.isdigit() or not name or NOT_GAMES.search(name) or not (int(flags or 0) & 4):    # 4 = fully installed
                continue
            out[f"{PREFIX}steam-{appid}.desktop"] = entry(name, f"steam steam://rungameid/{appid}", steam_icon(appid), "Steam")
            GAMES.append({"name": clean(name), "cmd": f"setsid steam steam://rungameid/{appid}", "cover": steam_cover(appid), "key": f"steam-{appid}"})
    try:
        installed = json.load(open(os.path.join(HOME, ".config", "heroic", "legendaryConfig", "legendary", "installed.json")))
    except (OSError, ValueError):
        installed = {}
    for app, info in (installed.items() if isinstance(installed, dict) else []):
        if re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", app or ""):
            out[f"{PREFIX}epic-{app}.desktop"] = entry((info or {}).get("title") or app, f"heroic --no-gui heroic://launch?appName={app}&runner=legendary", "heroic", "Epic")
            GAMES.append({"name": clean((info or {}).get("title") or app), "cmd": f"setsid heroic --no-gui heroic://launch?appName={app}&runner=legendary", "cover": "", "key": f"epic-{app}"})
    return out


def steam_cover(appid):
    """Moonlight shows a PNG box art (600x900). Steam's library cache has the game's portrait art as a JPEG: converted once, kept under Sunshine's folder."""
    dst = os.path.join(SUN_DIR, "covers", f"{PREFIX}{appid}.png")
    if os.path.isfile(dst):
        return dst
    for root in STEAM_ROOTS:
        for name in ("library_600x900.jpg", "header.jpg", "logo.png"):
            src = os.path.join(root, "appcache", "librarycache", appid, name)
            if os.path.isfile(src):
                try:
                    from PIL import Image
                    os.makedirs(os.path.dirname(dst), exist_ok=True)
                    im = Image.open(src).convert("RGBA")
                    im.thumbnail((600, 900))
                    im.save(dst + ".tmp", "PNG")
                    os.replace(dst + ".tmp", dst)
                    return dst
                except Exception:
                    return ""
    return ""


def sunshine_apps():
    """Keeps Sunshine's app list (what Moonlight shows for this host) = the place's own apps + one entry per installed game, each sized to the client
    first (place-sunshine-res) and started detached. Only apps whose command carries a game link are ours; the rest are kept as they are. When the
    list changes, Sunshine is told to reload it by saving its first app unchanged through its admin API (localhost only), so a stream is never cut."""
    path = os.path.join(SUN_DIR, "apps.json")
    port = os.environ.get("SUNSHINE_PORT", "")
    if not port.isdigit() or not os.path.isfile(path):
        return 0
    try:
        cur = json.load(open(path))
    except (OSError, ValueError):
        return 0
    own = lambda a: any(m in " ".join(a.get("detached") or []) + a.get("cmd", "") for m in OURS)
    keep = [a for a in cur.get("apps", []) if not own(a)]
    games = [{"name": g["name"], "image-path": g["cover"] or "desktop.png", "detached": [g["cmd"]],
              "prep-cmd": [{"do": "/usr/local/bin/place-sunshine-res", "undo": ""}]} for g in sorted(GAMES, key=lambda g: g["name"].lower())]
    new = dict(cur, apps=sorted(keep + games, key=lambda a: a.get("name", "")))     # Sunshine keeps its list sorted by name when it saves
    canon = lambda d: (sorted(json.dumps(a, sort_keys=True) for a in d.get("apps", [])), json.dumps({k: v for k, v in d.items() if k != "apps"}, sort_keys=True))
    if canon(new) == canon(cur):
        return 0
    with open(path + ".tmp", "w") as fh:
        json.dump(new, fh, indent=2)
    os.replace(path + ".tmp", path)
    pw = os.environ.get("SUNSHINE_ADMIN_PASS", "")
    if pw and keep:
        import base64, ssl, urllib.request
        body = json.dumps(dict(keep[0], index=0)).encode()
        req = urllib.request.Request(f"https://127.0.0.1:{int(port) + 1}/api/apps", data=body, method="POST", headers={
            "Content-Type": "application/json", "Authorization": "Basic " + base64.b64encode(f"admin:{pw}".encode()).decode()})
        try:
            urllib.request.urlopen(req, timeout=10, context=ssl._create_unverified_context()).read()
        except Exception as e:
            print(f"place-desktop-links: Sunshine did not reload its apps: {e}", file=sys.stderr)
    return 1


def trust(path):
    """Xfce 4.18+ runs a desktop launcher without asking only if it is executable and its sha256 is stored in the file's metadata."""
    os.chmod(path, 0o755)
    digest = hashlib.sha256(open(path, "rb").read()).hexdigest()
    try:
        subprocess.run(["gio", "set", "-t", "string", path, "metadata::xfce-exe-checksum", digest], capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass                                        # no gio here: the icon still works, Xfce just asks once


def sync():
    d = desktop_dir()
    os.makedirs(d, exist_ok=True)
    want, changed = wanted(), 0
    for f, body in want.items():
        p = os.path.join(d, f)
        try:
            same = open(p, encoding="utf-8", errors="replace").read() == body
        except OSError:
            same = False
        if not same:
            tmp = p + ".tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                fh.write(body)
            os.replace(tmp, p)
            trust(p)
            changed += 1
    for p in glob.glob(os.path.join(d, PREFIX + "*.desktop")):
        if os.path.basename(p) not in want:
            os.remove(p)
            changed += 1
    changed += sunshine_apps()
    return len(want), changed


def main(argv):
    every = int(argv[argv.index("--watch") + 1]) if "--watch" in argv else 0
    while True:
        try:
            n, c = sync()
            if not every:
                print(f"{n} icons, {c} changed")
        except Exception as e:                      # a bad manifest or a busy disk must not end the watch
            print(f"place-desktop-links: {e}", file=sys.stderr)
        if not every:
            return
        time.sleep(max(15, every))


if __name__ == "__main__":
    main(sys.argv[1:])
