# bridgeai: inbound firewall for the GPU host. Only the LAN reaches SSH and Sunshine; the gate (8700) only the Docker host and the operator's PC.
# Own table, so Docker's tables are never touched. Docker-published ports (webtop 3000/3001) go through FORWARD, not here.
# Resolve's scripting port (15000) is NOT open: the MCP runs on this machine.
table inet bridgeai_in
delete table inet bridgeai_in
table inet bridgeai_in {
    set lan { type ipv4_addr; flags interval; elements = { LAN_CIDR } }
    set gate_clients { type ipv4_addr; elements = { GATE_CLIENT_1, GATE_CLIENT_2 } }
    chain input {
        type filter hook input priority filter; policy drop;
        iif lo accept
        ct state established,related accept
        ct state invalid drop
        meta l4proto { icmp, ipv6-icmp } accept
        udp sport 67 udp dport 68 accept                      # DHCP replies
        ip6 saddr fe80::/10 accept                            # IPv6 link-local (neighbour discovery, DHCPv6)
        ip saddr @lan tcp dport 22 accept                     # SSH
        ip saddr @lan tcp dport { 47984, 47989, 47990, 48010 } accept   # Sunshine: https, http, web UI, RTSP
        ip saddr @lan udp dport { 47998, 47999, 48000, 48002, 48010, 5353 } accept   # Sunshine video, control, audio, mic; mDNS
        ip saddr @gate_clients tcp dport 8700 accept          # the GPU gate
    }
}
