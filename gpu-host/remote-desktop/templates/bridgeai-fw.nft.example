# bridgeai: inbound firewall for the GPU host. Only the LAN reaches SSH; Sunshine's stream ports are open to the internet behind a per-address limit (see below); the gate (8700) only the Docker host and the operator's PC.
# Own table, so Docker's tables are never touched. Docker-published ports (webtop 3000/3001) go through FORWARD, not here.
# Resolve's scripting port (15000) is NOT open: the MCP runs on this machine.
table inet bridgeai_in
delete table inet bridgeai_in
table inet bridgeai_in {
    set lan { type ipv4_addr; flags interval; elements = { LAN_CIDR } }
    set sun_flood { type ipv4_addr; size 8192; flags dynamic,timeout; timeout 10m; }
    set gate_clients { type ipv4_addr; elements = { GATE_CLIENT_1, GATE_CLIENT_2 } }
    chain input {
        type filter hook input priority filter; policy drop;
        iif lo accept
        ct state established,related accept
        ct state invalid drop
        meta l4proto { icmp, ipv6-icmp } accept
        udp sport 67 udp dport 68 accept                      # DHCP replies
        ip6 saddr fe80::/10 accept                            # IPv6 link-local (neighbour discovery, DHCPv6)
        ip saddr @lan tcp dport 22 accept                     # SSH
        # Sunshine with base port 48989 (sunshine.conf `port = 48989`; the default range 47984-48010 was already forwarded to another service).
        # Offsets of the base B: TCP B-5 https, B http, B+1 admin page, B+21 RTSP; UDP B+9 video, B+10 control, B+11 audio, B+13 mic.
        # The LAN gets all of it; the INTERNET (a router forward, the same numbers, no translation) gets everything except the admin page, and a single public
        # address may open only 30 new TCP connections a minute, so pairing cannot be hammered. Pairing itself needs the PIN typed on this host.
        ip saddr @lan tcp dport { 48984, 48989, 48990, 49010 } accept
        tcp dport { 48984, 48989, 49010 } ct state new add @sun_flood { ip saddr limit rate over 30/minute burst 60 packets } drop
        tcp dport { 48984, 48989, 49010 } accept
        ip saddr @lan udp dport 5353 accept                   # mDNS
        udp dport { 48998, 48999, 49000, 49002 } accept
        ip saddr @gate_clients tcp dport 8700 accept          # the GPU gate
    }
}
