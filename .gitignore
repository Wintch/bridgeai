# Secrets -- never commit these
.env
*.key
*.pem
aibridge/data/secret.key
aibridge/data/keys.json

# Runtime state generated by running the stack -- personal to each
# deployment, not part of the project itself
aibridge/data/
aibridge/user1-workdir/
aibridge/claude-config/
aibridge/antigravity-config/
aibridge/hermes-config/
aibridge/hermes-videos/
aibridge/hermes-ssh-keys/
aibridge/telegram-bot-api-data/
aibridge/fallback_watchdog_state.json
aibridge/fallback_watchdog.log

# Standard hygiene
__pycache__/
*.pyc
node_modules/
.DS_Store

# wake-on-demand: per-server state and config (real bind IPs, boot history, maintenance flag)
aibridge/ops/wake/stacks.json
aibridge/ops/wake/*.state.json
aibridge/ops/wake/NO_SLEEP
aibridge/ops/wake/__pycache__/
aibridge/web/wake/upstream.conf

# operator-only config (ops bot token, firewall addresses): never in git
aibridge/ops/ops.env
aibridge/ops/aibridge-fw.conf
*.bak-*
aibridge/ops/gateways.json
aibridge/gateways-hernik/
aibridge/stacks/*/gateways/
# per-person data of every stack and guest (the templates sit directly under stacks/ and guests/ and stay tracked)
aibridge/stacks/*/
aibridge/guests/*/
credentials.txt
aibridge/openwebui-data/
web-outputs/
telegram-outbox/
aibridge/ops/key_state.json
aibridge/ops/hostcare/hostcare.json
gpu-host/host.env

# hub (hub/HUB.md): per-server state and secrets
aibridge/hub.env
aibridge/hubdata/
aibridge/hub-off/
aibridge/ops/ads.json
aibridge/ops/ads_state.json
aibridge/ops/daily_ad.log

# task receiver (aibridge/ops/wake/TAREAS_HOOK.md): the webhook secret, its state, and the wake requests it writes for the waker
aibridge/ops/wake/tareas_hook.json
aibridge/ops/wake/*.task.json

# synthetic business days (aibridge/SYNTHETIC_DAY.md): the private target list (test stack addresses, key paths) and the results (counts files)
aibridge/ops/synth_targets.json
aibridge/ops/synth_results/

# This installation only (addresses, hosts, accounts, current state): kept out of the public repo
CURRENT_INSTALLATION.md
local-notes/
